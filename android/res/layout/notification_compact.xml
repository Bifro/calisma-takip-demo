<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notif_root" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="6dp" android:background="@drawable/notif_background">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
    <Chronometer android:id="@+id/notif_clock" android:layout_width="match_parent" android:layout_height="28dp" android:textSize="20sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:textColor="#f0f0f0" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1"/>
    <TextView android:id="@+id/notif_idle" android:layout_width="match_parent" android:layout_height="28dp" android:text="00:00:00" android:textSize="20sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:textColor="#f0f0f0" android:fontFamily="monospace" android:gravity="center_vertical" android:maxLines="1"/>
    <TextView android:id="@+id/notif_course" android:layout_width="match_parent" android:layout_height="14dp" android:textSize="10sp" android:textColor="#aaaaaa" android:singleLine="true" android:ellipsize="end"/>
  </LinearLayout>
  <Button android:id="@+id/notif_action" android:layout_width="84dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/notif_green" android:text="▶ Başlat" android:textSize="12sp" android:textColor="#ffffff" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:stateListAnimator="@null"/>
</LinearLayout>
