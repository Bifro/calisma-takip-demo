<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notif_root" android:layout_width="match_parent" android:layout_height="148dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/notif_background">
  <TextView android:id="@+id/notif_date" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#888888" android:textSize="10sp" android:singleLine="true"/>
  <Chronometer android:id="@+id/notif_clock" android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center" android:textSize="38sp" android:textColor="#f0f0f0" android:fontFamily="monospace" android:singleLine="true"/>
  <TextView android:id="@+id/notif_idle" android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center" android:text="00:00:00" android:textSize="38sp" android:textColor="#f0f0f0" android:fontFamily="monospace" android:singleLine="true"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="4dp">
    <Button android:id="@+id/notif_start" android:layout_width="108dp" android:layout_height="40dp" android:layout_marginRight="8dp" android:background="@drawable/notif_green" android:text="▶ Başlat" android:textSize="12sp" android:textColor="#ffffff" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:stateListAnimator="@null"/>
    <Button android:id="@+id/notif_stop" android:layout_width="108dp" android:layout_height="40dp" android:background="@drawable/notif_red" android:text="■ Kaydet" android:textSize="12sp" android:textColor="#ffffff" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:stateListAnimator="@null"/>
  </LinearLayout>
</LinearLayout>
